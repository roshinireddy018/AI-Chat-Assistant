{
  "name": "ai-chat-assistant-monorepo",
  "version": "1.0.0",
  "description": "Full-stack AI Chat Assistant foundation",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue.bold,magenta.bold\" \"npm run dev:server\" \"npm run dev:client\"",
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"blue.bold,magenta.bold\" \"npm run start:server\" \"npm run start:client\"",
    "dev:server": "npm run dev --prefix server",
    "start:server": "npm run start --prefix server",
    "dev:client": "npm run dev --prefix client",
    "start:client": "npm run preview --prefix client",
    "build:client": "npm run build --prefix client",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
